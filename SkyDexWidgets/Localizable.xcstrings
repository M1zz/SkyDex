    "밖을 한 번 올려다보면 이 시각 칸이 채워집니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívejte se jednou ven nahoru a buňka této hodiny se zaplní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kig op én gang udenfor, så udfyldes feltet for denne time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau einmal nach oben, dann füllt sich das Feld dieser Stunde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοιτάξτε προς τα πάνω μία φορά έξω και το τετράγωνο αυτής της ώρας θα γεμίσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look up once outside and this hour's cell fills in."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look up once outside and this hour's cell fills in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira hacia arriba una vez y la casilla de esta hora se llenará."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katso kerran ulos ylös, niin tämän tunnin ruutu täyttyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez les yeux une fois dehors et la case de cette heure se remplira."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tengok ke atas sekali di luar, dan kotak jam ini akan terisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alza lo sguardo una volta e la casella di quest’ora si riempirà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外で一度空を見上げると、この時刻のマスが埋まります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se opp én gang ute, så fylles ruten for denne timen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk buiten één keer omhoog en het vakje van dit uur wordt gevuld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spójrz raz w górę na zewnątrz, a pole tej godziny się wypełni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olhe para cima uma vez e o quadrado desta hora será preenchido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Взгляните на небо — и клетка этого часа заполнится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titta upp en gång utomhus så fylls rutan för den här timmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงยหน้ามองข้างนอกสักครั้ง แล้วช่องของชั่วโมงนี้จะถูกเติมเต็ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışarıda bir kez yukarı bak, bu saatin karesi dolar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngước nhìn ra ngoài một lần, ô của giờ này sẽ được lấp đầy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到外面抬头看一眼，这个时刻的格子就会被填上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到外面抬頭看一眼，這個時刻的格子就會被填上。"
          }
        }
      }
    },
