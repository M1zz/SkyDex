    "하루 마흔여덟 칸. 모은 하늘은 채워지고, 지금 시각에는 고리가 걸립니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čtyřicet osm buněk denně. Nasbíraná nebe je plní a prstenec označuje aktuální hodinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otteogfyrre felter om dagen. Indsamlede himle fylder dem, og en ring markerer den aktuelle time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtundvierzig Felder am Tag. Gesammelte Himmel füllen sie, ein Ring markiert die aktuelle Stunde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαράντα οκτώ τετράγωνα την ημέρα. Οι ουρανοί που συλλέγετε τα γεμίζουν και ένας δακτύλιος σημειώνει την τρέχουσα ώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty-eight cells a day. Collected skies fill in, and a ring marks the current hour."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty-eight cells a day. Collected skies fill in, and a ring marks the current hour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuarenta y ocho casillas al día. Los cielos reunidos las llenan y un anillo marca la hora actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neljäkymmentäkahdeksan ruutua päivässä. Kerätyt taivaat täyttävät ne, ja rengas merkitsee nykyisen tunnin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarante-huit cases par jour. Les ciels collectés les remplissent, et un anneau marque l’heure actuelle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empat puluh delapan kotak sehari. Langit yang terkumpul mengisinya, dan sebuah cincin menandai jam saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarantotto caselle al giorno. I cieli raccolti le riempiono e un anello segna l’ora attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日48マス。集めた空は埋まり、今の時刻にはリングがつきます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Førtiåtte ruter om dagen. Innsamlede himler fyller dem, og en ring markerer den aktuelle timen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtenveertig vakjes per dag. Verzamelde luchten vullen ze en een ring markeert het huidige uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czterdzieści osiem pól dziennie. Zebrane niebo je wypełnia, a pierścień oznacza bieżącą godzinę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarenta e oito quadrados por dia. Os céus reunidos os preenchem e um anel marca a hora atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сорок восемь клеток в день. Собранное небо заполняет клетку, а текущий час отмечен кольцом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrtioåtta rutor per dag. Insamlade himlar fyller dem och en ring markerar den aktuella timmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันละสี่สิบแปดช่อง ท้องฟ้าที่สะสมไว้จะเติมช่อง และวงแหวนจะบอกชั่วโมงปัจจุบัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde kırk sekiz kare. Toplanan gökyüzü kareleri doldurur, geçerli saati bir halka işaretler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bốn mươi tám ô mỗi ngày. Bầu trời đã sưu tầm lấp đầy các ô, và một vòng tròn đánh dấu giờ hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一天四十八格。收集到的天空会填上，当前时刻则标有一个圆环。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一天四十八格。收集到的天空會填上，目前時刻則標有一個圓環。"
          }
        }
      }
    },
