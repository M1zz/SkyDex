    "커튼을 걷었을 때의 바깥. 검정보다 조금 파랗다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outside, when you pull back the curtain. A little bluer than black."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outside, when you pull back the curtain. A little bluer than black."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーテンを開けたときの外。黒より少し青い。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉开窗帘时的窗外。比黑色稍蓝一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉開窗簾時的窗外。比黑色稍藍一點。"
