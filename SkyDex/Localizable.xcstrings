        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The navy of a jacket worn for years. Neither black nor blue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何年も着たジャケットの紺。黒でも青でもない。"
