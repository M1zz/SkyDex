    "손에 묻은 잉크를 헹군 물. 흐린 남색." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water you rinsed inky hands in. Pale navy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water you rinsed inky hands in. Pale navy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手についたインクをすすいだ水。くすんだ紺。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "洗掉手上墨水的水。暗淡的藏青。"
