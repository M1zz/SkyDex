    "빛을 먹는 검보라. 하루의 마지막 색." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A black purple that swallows light. The last color of the day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A black purple that swallows light. The last colour of the day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光を吸い込む黒紫。一日の最後の色。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吞没光线的黑紫。一天里最后的颜色。"
