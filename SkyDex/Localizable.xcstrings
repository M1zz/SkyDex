        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri to start snapping the sky right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri to start snapping the sky right away."
