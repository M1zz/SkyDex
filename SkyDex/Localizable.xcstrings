    "불빛 없는 데서 내려다본 물. 검정에 파랑이 한 겹." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water seen from above, far from any light. Black with a layer of blue."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water seen from above, far from any light. Black with a layer of blue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明かりのない場所から見下ろす水。黒に青をひと重ね。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在没有灯光的地方俯看的水。黑色上叠了一层蓝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在沒有燈光的地方俯看的水。黑色上疊了一層藍。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вода, если смотреть на неё сверху, где нет огней. Чёрный с налётом синего."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agua vista desde arriba, sin luces. Negro con una capa de azul."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasser von oben, ohne ein Licht. Schwarz mit einem Hauch Blau."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eau vue d'en haut, sans lumière. Du noir sous un voile de bleu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acqua vista dall'alto, senza luci. Nero con un velo di blu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Água vista de cima, sem nenhuma luz. Preto com uma camada de azul."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "น้ำที่มองลงไปจากที่ไร้แสงไฟ ดำที่มีน้ำเงินบางๆ หนึ่งชั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặt nước nhìn xuống từ nơi không đèn. Đen phủ một lớp xanh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voda shora, tam kde nesvítí žádná světla. Čerň s vrstvou modři."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vand set ovenfra, uden lys. Sort med et lag blåt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νερό ιδωμένο από ψηλά, χωρίς φως. Μαύρο με ένα πέπλο μπλε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vesi ylhäältä katsottuna, ilman valoja. Mustaa ja kerros sinistä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Air yang dilihat dari tempat tanpa cahaya. Hitam berlapis biru."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vann sett ovenfra, uten lys. Svart med et lag blått."
          }
        },
        "nl" : {
          "stringUnit" : {
