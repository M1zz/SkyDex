    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: Dynamic Type layouts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si agrandas el texto, las pantallas se reacomodan sin que nada se corte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字を大きくしても切れずに、きれいに並び直します。"
