    "일주일도 한 달도 같은 모양으로 돌아옵니다. 그 시각의 하늘만 한 번도 같지 않았습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týden i měsíc se vracejí ve stejném tvaru. Jen nebe v tu hodinu nebylo nikdy stejné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En uge eller en måned vender tilbage i samme form. Kun himlen på det tidspunkt har aldrig været den samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Woche oder ein Monat kehrt in derselben Form wieder. Nur der Himmel zu dieser Stunde war nie derselbe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια εβδομάδα ή ένας μήνας επιστρέφει με το ίδιο σχήμα. Μόνο ο ουρανός εκείνης της ώρας δεν ήταν ποτέ ο ίδιος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A week or a month comes round in the same shape. Only the sky at that hour has never once been the same."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A week or a month comes round in the same shape. Only the sky at that hour has never once been the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una semana o un mes vuelven con la misma forma. Solo el cielo de esa hora nunca ha sido igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une semaine ou un mois reviennent sous la même forme. Seul le ciel de cette heure n’a jamais été le même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una settimana o un mese tornano con la stessa forma. Solo il cielo di quell’ora non è mai stato lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一週間も一か月も、同じ形でめぐってきます。けれど、その時刻の空は一度も同じではありませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일주일도 한 달도 같은 모양으로 돌아옵니다. 그 시각의 하늘만 한 번도 같지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma semana ou um mês voltam com o mesmo formato. Só o céu daquela hora nunca foi o mesmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неделя и месяц возвращаются в прежнем виде. Только небо в этот час ни разу не было прежним."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หนึ่งสัปดาห์หรือหนึ่งเดือนวนกลับมาในรูปแบบเดิม มีเพียงท้องฟ้าของเวลานั้นเท่านั้นที่ไม่เคยเหมือนกันเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tuần hay một tháng đều quay lại với cùng một dáng vẻ. Chỉ có bầu trời của giờ ấy là chưa bao giờ giống nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一周也好，一个月也好，都会以同样的样子回来。只有那个时刻的天空，从来没有相同过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一週也好，一個月也好，都會以同樣的樣子回來。只有那個時刻的天空，從來沒有相同過。"
          }
        }
      }
    },
