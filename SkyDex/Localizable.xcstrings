        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A thought you had looking at this sky,\na word you'd like to leave"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pensamiento al mirar este cielo,\nuna frase que quieras dejar"
