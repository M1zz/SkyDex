    "태우고 남은 자국. 푸른 기 없는 검정." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's left after burning. Black without a trace of blue."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's left after burning. Black without a trace of blue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焦がしたあとの跡。青みのない黒。"
