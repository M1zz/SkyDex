        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viola quasi nero che inghiotte la luce. L'ultimo colore del giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roxo quase preto que engole a luz. A última cor do dia."
