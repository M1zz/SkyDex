    "이 하늘을 보면서 들었던 생각,\n하고 싶은 한 마디" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myšlenka při pohledu na toto nebe,\nslovo, které chcete zanechat"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tanke, du fik, mens du så på denne himmel,\net ord, du gerne vil efterlade"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gedanke beim Blick in diesen Himmel,\nein Wort, das du hinterlassen möchtest"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια σκέψη καθώς κοιτούσατε αυτόν τον ουρανό,\nμια λέξη που θέλετε να αφήσετε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A thought you had looking at this sky,\na word you'd like to leave"
