    "회색에 초록이 슬었다. 폭풍 직전에 가끔." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gray with green creeping in. Sometimes just before a storm."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grey with green creeping in. Sometimes just before a storm."
          }
        },
        "ja" : {
