    "먹에 가까운 검정, 한밤의 하늘" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Black close to ink, the midnight sky"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Black close to ink, the midnight sky"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "墨に近い黒、真夜中の空"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近似墨的黑，深夜的天空"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近似墨的黑，深夜的天空"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почти чёрный, как тушь; полуночное небо"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negro casi de tinta, el cielo a medianoche"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwarz wie Tusche, der Himmel um Mitternacht"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un noir proche de l'encre, le ciel de minuit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nero quasi d'inchiostro, il cielo a mezzanotte"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preto quase nanquim, o céu à meia-noite"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดำเกือบเหมือนหมึก ท้องฟ้ายามดึก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đen gần như mực tàu, bầu trời nửa đêm"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čerň blízká tuši, půlnoční obloha"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sort som tusch, himlen ved midnat"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαύρο κοντά στο μελάνι, ο ουρανός των μεσανυχτών"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tussia lähellä oleva musta, keskiyön taivas"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitam yang mendekati tinta bak, langit tengah malam"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svart som tusj, himmelen ved midnatt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwart dat naar inkt neigt, de lucht om middernacht"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czerń bliska tuszu, niebo o północy"
