      }
    },
    "일주일도 한 달도 같은 모양으로 돌아옵니다. 그 시각의 하늘만 한 번도 같지 않았습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A week or a month comes round in the same shape. Only the sky at that hour has never once been the same."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A week or a month comes round in the same shape. Only the sky at that hour has never once been the same."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一週間も一か月も、同じ形でめぐってきます。けれど、その時刻の空は一度も同じではありませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일주일도 한 달도 같은 모양으로 돌아옵니다. 그 시각의 하늘만 한 번도 같지 않았습니다."
          }
        }
      }
