    "아직 한 번도 안 빤 데님. 진한 남색." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denim that's never been washed. Deep navy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denim that's never been washed. Deep navy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度も洗っていないデニム。濃い紺。"
