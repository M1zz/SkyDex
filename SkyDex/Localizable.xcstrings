    "사진과 색이 함께 사라집니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotka i barva se smažou společně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billedet og dets farve fjernes sammen."
