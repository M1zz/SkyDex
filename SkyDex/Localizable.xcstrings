          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos sont enregistrées sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto vengono salvate su questo dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos ficam salvas neste aparelho."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปภาพจะถูกบันทึกไว้ในอุปกรณ์นี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh được lưu trên thiết bị này."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotky se ukládají do tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billederne gemmes på denne enhed."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες αποθηκεύονται σε αυτή τη συσκευή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvat tallennetaan tähän laitteeseen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto disimpan di perangkat ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildene lagres på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
