    "건물 위쪽이 지워진 아침. 푸르스름한 밝은 회색." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A morning that erased the tops of buildings. Pale bluish gray."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A morning that erased the tops of buildings. Pale bluish grey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビルの上のほうが消えた朝。青みがかった明るい灰色。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楼顶被抹去的早晨。泛蓝的浅灰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "樓頂被抹去的早晨。泛藍的淺灰。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утро, стёршее верхушки домов. Светло-серый с голубизной."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mañana que borró lo alto de los edificios. Gris claro azulado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Morgen, an dem die Dächer verschwinden. Helles, bläuliches Grau."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un matin où le haut des immeubles s'efface. Un gris clair bleuté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mattino che ha cancellato la cima dei palazzi. Grigio chiaro azzurrino."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma manhã que apagou o alto dos prédios. Cinza-claro azulado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เช้าที่ยอดตึกหายไป เทาอ่อนอมฟ้า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buổi sáng đầu các tòa nhà bị xóa mờ. Xám sáng hơi xanh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ráno, které smazalo vršky budov. Světlá šeď do modra."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En morgen, hvor toppen af husene forsvinder. Lys, blålig grå."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα πρωί που σβήνει τις κορυφές των κτιρίων. Ανοιχτό γαλαζωπό γκρι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aamu, jolloin talojen yläosat ovat pyyhkiytyneet pois. Vaalea, sinertävä harmaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagi saat puncak gedung terhapus. Kelabu terang kebiruan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En morgen der toppen av husene forsvinner. Lys, blålig grå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ochtend die de bovenkant van gebouwen uitwiste. Licht blauwig grijs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poranek, który wymazał szczyty budynków. Jasna szarość z nutą błękitu."
