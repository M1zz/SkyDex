        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu của chỗ chân không chạm đáy. Xanh chàm tối và mát lạnh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva míst, kde nedosáhnete na dno. Tmavá, chladná námořnická modř."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farven der, hvor fødderne ikke kan nå bunden. Mørk, kølig marineblå."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το χρώμα εκεί που δεν πατάς. Σκούρο, δροσερό μπλε μαρέν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väri siellä, missä jalat eivät yllä pohjaan. Tumma, viileä laivastonsininen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna tempat kaki tak lagi menyentuh dasar. Biru tua yang gelap dan sejuk."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fargen der føttene ikke når bunnen. Mørk, kjølig marineblå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kleur van waar je de bodem niet raakt. Donker, koel marineblauw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolor miejsca, gdzie nie sięga się dna. Ciemny, chłodny granat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färgen där fötterna inte når botten. Mörk, sval marinblå."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayağın yere değmediği yerin rengi. Karanlık ve serin bir lacivert."
          }
        }
      }
    },
