        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajatus, joka tuli tätä taivasta katsoessa,\nsana, jonka haluat jättää"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pensée en regardant ce ciel,\nun mot à laisser"
