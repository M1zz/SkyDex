    "안에서 밖을 보면 뿌옇다. 푸른 회색." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazy when you look out from inside. A bluish gray."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazy when you look out from inside. A bluish grey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内から外を見ると白くかすむ。青みの灰色。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从里往外看，一片朦胧。蓝灰色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從裡往外看，一片朦朧。藍灰色。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изнутри всё мутно. Голубовато-серый."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde adentro, afuera se ve borroso. Gris azulado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von drinnen sieht draußen alles milchig aus. Bläuliches Grau."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De l'intérieur, le dehors est flou. Un gris bleuté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da dentro, fuori è tutto sfocato. Grigio azzurro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dentro, o lado de fora fica borrado. Cinza-azulado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มองจากข้างในออกไปจะพร่ามัว เทาอมฟ้า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhìn từ trong ra thấy mờ mờ. Xám ngả xanh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zevnitř je všechno zamlžené. Namodralá šeď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indefra ser alt udenfor mælket ud. Blålig grå."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από μέσα, το έξω φαίνεται θολό. Γαλαζωπό γκρι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisältä ulos katsoessa utuista. Sinertävä harmaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dari dalam, luar tampak buram. Kelabu kebiruan."
