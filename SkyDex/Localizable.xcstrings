          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture the sky at the same time on another day, and the two will stand side by side here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si captas el cielo a la misma hora otro día, los dos quedarán juntos aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の日の同じ時刻にもう一度空を撮ると、ふたつがここに並びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 시각의 하늘을 다른 날에 한 번 더 찍으면, 그 둘이 여기에서 나란히 섭니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимите небо в то же время в другой день — и два кадра окажутся здесь рядом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一天的同一时刻再拍一次天空，两张就会在这里并排出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一天的同一時刻再拍一次天空，兩張就會在這裡並排出現。"
          }
        }
      }
    },
    "같은 시각, 같은 하루" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same hour, same day"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
