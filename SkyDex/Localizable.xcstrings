    "이 자리는 그 시간대에 찍은 하늘로 채워집니다. 어떤 사진이든 그대로 들어가고, 색이 맞아야 할 필요는 없습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto místo se zaplní nebem pořízeným v téhle části dne. Vejde se jakákoli fotka tak, jak je; barva se shodovat nemusí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pladsen fyldes med en himmel taget på det tidspunkt af dagen. Ethvert billede kommer ind, som det er; farven behøver ikke passe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Platz füllt sich mit einem Himmel aus dieser Tageszeit. Jedes Foto wird unverändert übernommen; die Farbe muss nicht passen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η θέση γεμίζει με έναν ουρανό που τραβήχτηκε εκείνο το μέρος της ημέρας. Κάθε φωτογραφία μπαίνει όπως είναι· το χρώμα δεν χρειάζεται να ταιριάζει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This spot fills with a sky taken in that part of the day. Any photo goes in as it is; the colour doesn't have to match."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This spot fills with a sky taken in that part of the day. Any photo goes in as it is; the colour doesn't have to match."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este lugar se llena con un cielo captado en esa parte del día. Cualquier foto entra tal cual; el color no tiene por qué coincidir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette place se remplit avec un ciel pris à ce moment de la journée. Toute photo y entre telle quelle ; la couleur n’a pas besoin de correspondre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo posto si riempie con un cielo scattato in quella parte della giornata. Qualsiasi foto entra così com’è; il colore non deve per forza corrispondere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここには、その時間帯に撮った空が入ります。どんな写真でもそのまま入り、色が合っている必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 자리는 그 시간대에 찍은 하늘로 채워집니다. 어떤 사진이든 그대로 들어가고, 색이 맞아야 할 필요는 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este lugar é preenchido com um céu captado nesse período do dia. Qualquer foto entra como está; a cor não precisa combinar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это место заполнится небом, снятым в это время суток. Подойдёт любое фото как есть — цвет совпадать не обязан."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่องนี้จะถูกเติมด้วยท้องฟ้าที่ถ่ายในช่วงเวลานั้นของวัน รูปไหนก็ใส่ได้ตามเดิม สีไม่จำเป็นต้องตรงกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỗ này sẽ được lấp bằng bầu trời chụp trong khoảng thời gian đó của ngày. Ảnh nào cũng vào được nguyên vẹn; màu không cần phải khớp."
          }
        },
        "zh-Hans" : {
