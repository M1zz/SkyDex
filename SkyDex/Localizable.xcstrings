    "벼루에 갈아 놓은 먹. 가장 깊은 밤." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink ground on an inkstone. The deepest night."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink ground on an inkstone. The deepest night."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "硯ですった墨。いちばん深い夜。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "砚台里磨出的墨。最深的夜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "硯台裡磨出的墨。最深的夜。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тушь, растёртая на тушечнице. Самая глубокая ночь."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinta molida en la piedra de entintar. La noche más honda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Reibstein angeriebene Tusche. Die tiefste Nacht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'encre broyée sur la pierre. La nuit la plus profonde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inchiostro macinato sulla pietra. La notte più fonda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinta moída na pedra de tinta. A noite mais funda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมึกแท่งที่ฝนบนจานฝน ค่ำคืนที่ลึกที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mực mài trên nghiên. Đêm sâu nhất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuš rozetřená na kameni. Nejhlubší noc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tusch revet på stenen. Den dybeste nat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μελάνι τριμμένο στην πέτρα. Η πιο βαθιά νύχτα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kivellä hierottu tussi. Syvin yö."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinta yang digerus di batu tinta. Malam yang paling dalam."
