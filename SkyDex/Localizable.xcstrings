    "발이 닿지 않는 곳의 색. 어둡고 서늘한 남색." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The color of where your feet don't touch. Dark, cool navy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The colour of where your feet don't touch. Dark, cool navy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足の届かない場所の色。暗くひんやりした紺。"
