    "설치 수와 버전 분포. 읽으려면 허브 컨테이너의 read 권한이 필요합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počty instalací a rozložení verzí. Ke čtení je potřeba oprávnění ke čtení kontejneru hubu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal installationer og versionsfordeling. For at læse dem kræves læseadgang til hub-containeren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installationszahlen und Versionsverteilung. Zum Lesen wird Lesezugriff auf den Hub-Container benötigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αριθμός εγκαταστάσεων και κατανομή εκδόσεων. Για την ανάγνωση χρειάζεται δικαίωμα ανάγνωσης στο κοντέινερ του hub."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install counts and version spread. Reading them needs read access to the hub container."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install counts and version spread. Reading them needs read access to the hub container."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de instalaciones y reparto por versiones. Para leerlos se necesita acceso de lectura al contenedor del hub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d’installations et répartition des versions. Leur lecture nécessite un accès en lecture au conteneur du hub."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero di installazioni e distribuzione delle versioni. Per leggerli serve l’accesso in lettura al contenitore dell’hub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール数とバージョンの内訳です。読み取るにはハブコンテナの読み取り権限が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치 수와 버전 분포. 읽으려면 허브 컨테이너의 read 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de instalações e distribuição de versões. Para ler, é preciso ter acesso de leitura ao contêiner do hub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Число установок и распределение по версиям. Для чтения нужен доступ на чтение к контейнеру хаба."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนการติดตั้งและการกระจายของเวอร์ชัน การอ่านต้องมีสิทธิ์อ่านของคอนเทนเนอร์ฮับ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số lượt cài đặt và phân bố phiên bản. Cần quyền đọc đối với vùng chứa hub để xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装数量与版本分布。读取需要中心容器的读取权限。"
