        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улица за отдёрнутой шторой. Чуть синее чёрного."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo de afuera al correr la cortina. Apenas más azul que el negro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draußen, wenn du den Vorhang aufziehst. Etwas blauer als Schwarz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dehors quand on tire le rideau. Un peu plus bleu que le noir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuori, quando scosti la tenda. Appena più blu del nero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O lado de fora ao abrir a cortina. Só um pouco mais azul que o preto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้างนอกตอนเปิดม่าน ฟ้ากว่าสีดำอีกนิด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bên ngoài lúc vén rèm. Xanh hơn màu đen một chút."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venku za odhrnutým závěsem. O něco modřejší než čerň."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udenfor, når du trækker gardinet fra. Lidt blåere end sort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έξω, όταν τραβάς την κουρτίνα. Λίγο πιο μπλε από το μαύρο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näkymä, kun vedät verhot sivuun. Vähän sinisempää kuin musta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di luar saat tirai dibuka. Sedikit lebih biru dari hitam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utenfor når du trekker fra gardinen. Litt blåere enn svart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buiten, als je het gordijn opzij schuift. Iets blauwer dan zwart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świat za odsuniętą zasłoną. Odrobinę bardziej niebieski niż czerń."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utsikten när du drar undan gardinen. Lite blåare än svart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdeyi açınca dışarısı. Siyahtan biraz daha mavi."
          }
        }
      }
    },
