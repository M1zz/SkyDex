    "다 타고 남은 것. 흐린 날 낮의 표준 회색." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's left when everything has burned. The standard gray of an overcast day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's left when everything has burned. The standard grey of an overcast day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燃え尽きたあとのもの。曇りの日の昼の、標準の灰色。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燃尽之后剩下的东西。阴天白昼的标准灰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燃盡之後剩下的東西。陰天白晝的標準灰。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что осталось после огня. Обычный серый пасмурного дня."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que queda cuando todo se quemó. El gris de siempre en un día nublado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was nach dem Feuer bleibt. Das übliche Grau eines trüben Tages."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui reste après le feu. Le gris ordinaire d'un jour couvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che resta quando tutto è bruciato. Il grigio tipico di un giorno coperto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que sobra depois que tudo queimou. O cinza típico de um dia nublado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่เหลือหลังไหม้หมด เทามาตรฐานของกลางวันครึ้ม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thứ còn lại khi đã cháy hết. Màu xám chuẩn của ngày âm u."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co zbude po ohni. Obyčejná šeď zamračeného dne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, der er tilbage, når alt er brændt. Den almindelige grå på en gråvejrsdag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ό,τι μένει μετά τη φωτιά. Το συνηθισμένο γκρι μιας συννεφιασμένης μέρας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, mikä jää, kun kaikki on palanut. Pilvisen päivän perusharmaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisa yang sudah habis terbakar. Kelabu biasa di siang berawan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som er igjen når alt har brent. Den vanlige gråfargen en gråværsdag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat overblijft als alles is opgebrand. Het gewone grijs van een bewolkte dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co zostaje po ogniu. Zwykła szarość pochmurnego dnia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som blir kvar när allt brunnit. Standardgrått en mulen dag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıp bitenden geriye kalan. Bulutlu bir günün sıradan grisi."
          }
        }
      }
    },
