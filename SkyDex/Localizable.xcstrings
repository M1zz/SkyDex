        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím đen nuốt ánh sáng. Màu cuối cùng của ngày."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
