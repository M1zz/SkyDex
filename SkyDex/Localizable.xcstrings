        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吞沒光線的黑紫。一天裡最後的顏色。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чёрно-лиловый, поглощающий свет. Последний цвет дня."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morado negruzco que se traga la luz. El último color del día."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwarzlila, das das Licht schluckt. Die letzte Farbe des Tages."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un violet noir qui boit la lumière. La dernière couleur du jour."
          }
