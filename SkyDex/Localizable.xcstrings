        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚够不到底的地方。幽暗清冷的藏青。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳踩不到底的地方。幽暗清冷的藏青。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет там, где не достать дна. Тёмная прохладная синева."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color de donde ya no tocas fondo. Azul marino oscuro y frío."
