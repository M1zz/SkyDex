    "Face ID로 앱을 잠가 내 하늘 기록을 지켜요." : {
      "comment" : "Roadmap item detail: Face ID lock",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamkněte aplikaci přes Face ID a udržte svá nebe v soukromí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID, så dine himle forbliver private."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre die App mit Face ID, damit deine Himmel privat bleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλειδώστε την εφαρμογή με Face ID για να μένουν ιδιωτικοί οι ουρανοί σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID to keep your skies private."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID to keep your skies private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la app con Face ID para mantener tus cielos en privado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitse appi Face ID:llä, niin taivaasi pysyvät yksityisinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillez l’app avec Face ID pour garder vos ciels pour vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci aplikasi dengan Face ID agar langit koleksimu tetap pribadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca l’app con Face ID per tenere privati i tuoi cieli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID でアプリをロックして、空の記録を自分だけのものに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID로 앱을 잠가 내 하늘 기록을 지켜요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID, så himlene dine forblir private."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendel de app met Face ID, zodat je luchten privé blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokuj aplikację za pomocą Face ID, aby twoje niebo zostało tylko dla ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueie o app com o Face ID para manter seus céus só seus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте приложение с помощью Face ID, чтобы ваши записи о небе остались личными."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID så att dina himlar förblir privata."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล็อกแอปด้วย Face ID เพื่อให้บันทึกท้องฟ้าของคุณเป็นส่วนตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gökyüzü kayıtlarını özel tutmak için uygulamayı Face ID ile kilitle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa ứng dụng bằng Face ID để giữ riêng tư những bầu trời của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 锁住 App，守护你的天空记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 鎖住 App，守護你的天空紀錄。"
          }
        }
      }
    },
    "Siri에게 말하면 바로 하늘을 찍을 수 있어요." : {
      "comment" : "Roadmap item detail: Siri and Shortcuts",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekněte to Siri a hned můžete fotit nebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig det til Siri, og tag straks et billede af himlen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag es Siri, und du kannst sofort den Himmel fotografieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε το στη Siri και φωτογραφίστε τον ουρανό αμέσως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri to start snapping the sky right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri to start snapping the sky right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dile a Siri que quieres fotografiar el cielo y empieza al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano Siri-äänelle, ja voit kuvata taivaan saman tien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-le à Siri et photographiez le ciel tout de suite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilang saja ke Siri, dan kamu langsung bisa memotret langit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedilo a Siri e fotografa subito il cielo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri に話しかけるだけで、すぐに空を撮れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri에게 말하면 바로 하늘을 찍을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si det til Siri, så kan du ta bilde av himmelen med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg het tegen Siri en maak meteen een foto van de lucht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz to Siri i od razu zrób zdjęcie nieba."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale com a Siri e comece a fotografar o céu na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите Siri — и сразу снимайте небо."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg det till Siri så kan du fota himlen direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอก Siri แล้วถ่ายภาพท้องฟ้าได้ทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri’ye söylemen yeter, hemen gökyüzünü çekebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần nói với Siri là chụp được bầu trời ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对 Siri 说一声，就能马上拍下天空。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對 Siri 說一聲，就能立刻拍下天空。"
          }
        }
      }
    },
