    "불빛이 지나간 뒤의 유리. 남색에 가까운 회색." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glass after the lights have passed. A gray close to navy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glass after the lights have passed. A grey close to navy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明かりが過ぎ去ったあとのガラス。紺に近い灰色。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灯光掠过之后的玻璃。接近藏青的灰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燈光掠過之後的玻璃。接近藏青的灰。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стекло, когда огни уже пронеслись мимо. Серый, почти тёмно-синий."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vidrio después de que pasan las luces. Gris casi azul marino."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glas, nachdem die Lichter vorbeigezogen sind. Grau, fast marineblau."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitre après le passage des lumières. Un gris presque marine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vetro dopo che le luci sono passate. Grigio quasi blu notte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vidro depois que as luzes passam. Cinza quase azul-marinho."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กระจกหลังแสงไฟผ่านไป เทาที่เกือบเป็นกรมท่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ô kính sau khi ánh đèn lướt qua. Xám ngả xanh chàm."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sklo poté, co kolem probleskla světla. Šeď blízká tmavé modři."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasset, når lysene er gledet forbi. Grå, næsten marineblå."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τζάμι αφού περάσουν τα φώτα. Γκρι σχεδόν μπλε μαρέν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasi, kun valot ovat menneet ohi. Harmaata, melkein laivastonsinistä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaca setelah cahaya lewat. Kelabu yang hampir biru tua."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasset når lysene har passert. Grå, nesten marineblå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glas nadat de lichtjes voorbij zijn. Grijs dat naar marineblauw neigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szkło, gdy światła już przemknęły. Szarość bliska granatu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glaset när ljusen har passerat. Grått, nästan marinblått."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Işıklar geçtikten sonraki cam. Laciverde yakın bir gri."
          }
        }
      }
    },
