    "같은 시각의 하늘을 다른 날에 한 번 더 찍으면, 그 둘이 여기에서 나란히 섭니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyfoťte nebe ve stejnou hodinu jiný den a obě fotky tu budou stát vedle sebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang himlen på samme tidspunkt en anden dag, så står de to her side om side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiere den Himmel zur gleichen Uhrzeit an einem anderen Tag, dann stehen die beiden hier nebeneinander."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φωτογραφίστε τον ουρανό την ίδια ώρα μια άλλη μέρα και οι δύο θα εμφανιστούν εδώ δίπλα-δίπλα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture the sky at the same time on another day, and the two will stand side by side here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture the sky at the same time on another day, and the two will stand side by side here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si captas el cielo a la misma hora otro día, los dos quedarán juntos aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvaa taivas samaan aikaan toisena päivänä, niin kaksi kuvaa asettuu tähän vierekkäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographiez le ciel à la même heure un autre jour, et les deux apparaîtront côte à côte ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potret langit pada jam yang sama di hari lain, lalu keduanya akan berdampingan di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cattura il cielo alla stessa ora in un altro giorno e i due compariranno qui, uno accanto all’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の日の同じ時刻にもう一度空を撮ると、ふたつがここに並びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 시각의 하늘을 다른 날에 한 번 더 찍으면, 그 둘이 여기에서 나란히 섭니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang himmelen på samme tidspunkt en annen dag, så står de to her side om side."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak op een andere dag op hetzelfde tijdstip een foto van de lucht, dan staan de twee hier naast elkaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób zdjęcie nieba o tej samej porze innego dnia, a obydwa staną tu obok siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capte o céu no mesmo horário em outro dia e os dois ficam lado a lado aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимите небо в то же время в другой день — и два кадра окажутся здесь рядом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fånga himlen vid samma tid en annan dag så hamnar de två här bredvid varandra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ่ายท้องฟ้าเวลาเดิมในอีกวัน แล้วทั้งสองภาพจะมาเรียงคู่กันที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gökyüzünü başka bir gün aynı saatte çek, ikisi burada yan yana durur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chụp bầu trời vào cùng giờ ở một ngày khác, hai ảnh sẽ đứng cạnh nhau ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一天的同一时刻再拍一次天空，两张就会在这里并排出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一天的同一時刻再拍一次天空，兩張就會在這裡並排出現。"
          }
        }
      }
    },
