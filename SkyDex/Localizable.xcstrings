    "닦아도 그대로인 색. 푸른 기 도는 중간 회색." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stays this color however you wipe it. Mid gray with a hint of blue."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stays this colour however you wipe it. Mid grey with a hint of blue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拭いても変わらない色。青みのある中間の灰色。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擦了也不变的颜色。泛蓝的中灰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擦了也不變的顏色。泛藍的中灰。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет, который не оттирается. Средний серый с голубизной."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue igual aunque la limpies. Gris medio azulado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Farbe, die auch nach dem Putzen bleibt. Mittleres Grau mit Blaustich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une couleur qui reste même après nettoyage. Un gris moyen bleuté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta uguale anche dopo averla pulita. Grigio medio azzurrato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua igual mesmo depois de limpar. Cinza médio azulado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีที่เช็ดแล้วก็ยังเหมือนเดิม เทากลางอมฟ้า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lau rồi vẫn thế. Xám trung tính ngả xanh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva, kterou nesmyjete. Středně šedá do modra."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En farve, der bliver siddende, selv når du pudser. Mellemgrå med et blåt skær."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα χρώμα που μένει όσο κι αν το καθαρίσεις. Γαλαζωπό μεσαίο γκρι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väri, joka ei lähde pyyhkimällä. Sinertävä keskiharmaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna yang tak hilang meski dilap. Kelabu sedang kebiruan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En farge som blir sittende selv når du pusser. Mellomgrå med blått skjær."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij blijft deze kleur, hoe je ook poetst. Middengrijs met een zweem van blauw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolor, którego nie da się zmyć. Średnia szarość z nutą błękitu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färgen som inte går bort hur du än torkar. Mellangrått med blå ton."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silseniz de değişmeyen renk. Mavimsi orta gri."
          }
        }
      }
