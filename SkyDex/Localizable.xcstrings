    "몇 해 입은 재킷의 남색. 검지도 파랗지도 않다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The navy of a jacket worn for years. Neither black nor blue."
          }
