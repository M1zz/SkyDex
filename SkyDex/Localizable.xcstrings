    "이 색에 가까운 하늘을 찍으면 여기에 쌓입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyfoťte nebe blízké této barvě a nashromáždí se tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang en himmel tæt på denne farve, så samles den her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm einen Himmel in dieser Farbe auf, dann sammelt er sich hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φωτογραφίστε έναν ουρανό κοντά σε αυτό το χρώμα και θα συγκεντρωθεί εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture a sky close to this colour and it will gather here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture a sky close to this colour and it will gather here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capta un cielo parecido a este color y se acumulará aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captez un ciel proche de cette couleur et il viendra s’ajouter ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cattura un cielo vicino a questo colore e si raccoglierà qui."
