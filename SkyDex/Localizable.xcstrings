    "졸아든 뒤의 붉은색. 가장 진한 노을." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The red of spicy rice-cake sauce, cooked down. The deepest sunset."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The red of spicy rice-cake sauce, cooked down. The deepest sunset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煮詰まったあとの赤。いちばん濃い夕焼け。"
