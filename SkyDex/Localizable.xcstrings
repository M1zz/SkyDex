    "구름 없는 날이라면 이 시각 하늘은 %@입니다. 흐리거나 비가 오는 날은 이보다 회색에 가깝습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a cloudless day, the sky at this hour is %@. On cloudy or rainy days it's closer to gray."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a cloudless day, the sky at this hour is %@. On cloudy or rainy days it's closer to grey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雲のない日なら、この時刻の空は%@です。曇りや雨の日は、これより灰色に近くなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果是无云的日子，这个时刻的天空是%@。阴天或下雨时会比这更接近灰色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果是無雲的日子，這個時刻的天空是%@。陰天或下雨時會比這更接近灰色。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В безоблачный день небо в это время — %@. В пасмурную или дождливую погоду оно ближе к серому."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un día sin nubes, el cielo a esta hora es %@. Los días nublados o de lluvia se acerca más al gris."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An einem wolkenlosen Tag hat der Himmel um diese Uhrzeit die Farbe %@. Bei Wolken oder Regen ist er grauer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par temps sans nuages, le ciel à cette heure serait %@. Par temps couvert ou pluvieux, il tire davantage vers le gris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In un giorno senza nuvole, il cielo a quest'ora è %@. Quando è coperto o piove, tende di più al grigio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num dia sem nuvens, o céu a esta hora é %@. Em dias nublados ou de chuva, fica mais perto do cinza."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าเป็นวันที่ไม่มีเมฆ ท้องฟ้าเวลานี้จะเป็น%@ วันที่ครึ้มหรือฝนตกจะออกไปทางเทามากกว่านี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vào ngày không mây, bầu trời lúc này có màu %@. Ngày âm u hay mưa thì ngả xám hơn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za bezmračného dne má obloha v tuto dobu barvu %@. Když je zataženo nebo prší, bývá šedší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På en skyfri dag har himlen på dette tidspunkt farven %@. Når det er overskyet eller regner, er den mere grå."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μια μέρα χωρίς σύννεφα, ο ουρανός αυτή την ώρα θα ήταν %@. Όταν έχει συννεφιά ή βροχή, γέρνει περισσότερο προς το γκρι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilvettömänä päivänä taivas on tähän aikaan väriltään %@. Pilvisenä tai sateisena päivänä se on harmaampi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di hari tanpa awan, langit pada jam ini berwarna %@. Saat mendung atau hujan, warnanya lebih mendekati kelabu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En skyfri dag har himmelen på dette tidspunktet fargen %@. Når det er overskyet eller regner, er den gråere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op een wolkeloze dag is de lucht op dit uur %@. Bij bewolking of regen is hij grijzer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W bezchmurny dzień niebo o tej porze ma kolor %@. W pochmurne lub deszczowe dni jest bliższe szarości."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En molnfri dag har himlen den här tiden färgen %@. När det är mulet eller regnar är den gråare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulutsuz bir günde bu saatte gökyüzü %@ olurdu. Bulutlu ya da yağmurlu günlerde daha griye yakındır."
          }
        }
      }
    },
