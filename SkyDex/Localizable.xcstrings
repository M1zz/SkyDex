    "사진은 이 기기에 저장됩니다. iCloud에 로그인하면 기기를 바꿔도 남습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are saved on this device. Sign in to iCloud to keep them when you change devices."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are saved on this device. Sign in to iCloud to keep them when you change devices."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真はこのデバイスに保存されます。iCloudにサインインすれば、機種を変えても残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片保存在这台设备上。登录 iCloud 后，换了设备也会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片儲存在這部裝置上。登入 iCloud 後，換了裝置也會保留。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото хранятся на этом устройстве. Если войти в iCloud, они сохранятся и при смене устройства."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se guardan en este dispositivo. Si inicias sesión en iCloud, se conservan aunque cambies de dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos werden auf diesem Gerät gespeichert. Wenn du dich bei iCloud anmeldest, bleiben sie auch bei einem Gerätewechsel erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos sont enregistrées sur cet appareil. Connectez-vous à iCloud pour les garder même en changeant d'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto vengono salvate su questo dispositivo. Se accedi a iCloud, restano anche quando cambi dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos ficam salvas neste aparelho. Se você entrar no iCloud, elas continuam com você mesmo se trocar de aparelho."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปภาพจะถูกบันทึกไว้ในอุปกรณ์นี้ ถ้าลงชื่อเข้าใช้ iCloud รูปจะยังอยู่แม้เปลี่ยนเครื่อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh được lưu trên thiết bị này. Nếu đăng nhập iCloud, ảnh vẫn còn khi bạn đổi máy."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotky se ukládají do tohoto zařízení. Když se přihlásíte k iCloudu, zůstanou vám i po výměně zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billederne gemmes på denne enhed. Hvis du logger ind på iCloud, bliver de, også når du skifter enhed."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες αποθηκεύονται σε αυτή τη συσκευή. Αν συνδεθείτε στο iCloud, θα μείνουν ακόμη κι αν αλλάξετε συσκευή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvat tallennetaan tähän laitteeseen. Kun kirjaudut iCloudiin, ne säilyvät, vaikka vaihtaisit laitetta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto disimpan di perangkat ini. Jika kamu masuk ke iCloud, foto tetap ada meski kamu ganti perangkat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildene lagres på denne enheten. Logger du på iCloud, blir de værende selv om du bytter enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto's worden op dit apparaat bewaard. Log in bij iCloud om ze te houden als je van apparaat wisselt."
          }
        },
        "pl" : {
