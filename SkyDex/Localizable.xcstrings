    "발이 안 닿는 쪽 물색. 한여름 정오의 꼭대기." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The water at the deep end. The top of the sky at midsummer noon."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The water at the deep end. The top of the sky at midsummer noon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足の届かないほうの水の色。真夏の正午の天頂。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚够不到底那一侧的水色。盛夏正午的天顶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳踩不到底那一側的水色。盛夏正午的天頂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вода там, где не достать дна. Вершина летнего полудня."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agua donde ya no tocas fondo. Lo más alto del cielo un mediodía de verano."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasser dort, wo man nicht mehr steht. Der Zenit an einem Hochsommermittag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eau du côté où l'on n'a plus pied. Le zénith d'un midi d'été."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acqua dove non tocchi più. La cima del cielo a mezzogiorno, in piena estate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A água onde o pé não alcança. O alto do céu ao meio-dia, em pleno verão."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีน้ำฝั่งที่เท้าแตะไม่ถึง จุดสูงสุดของเที่ยงวันกลางฤดูร้อน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu nước ở phía chân không chạm đáy. Đỉnh trời trưa giữa hè."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voda tam, kde nedosáhnete na dno. Vrchol letního poledne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandet, hvor man ikke kan bunde. Himlens top ved middagstid midt på sommeren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το νερό στη μεριά που δεν πατάς. Το ζενίθ ενός καλοκαιρινού μεσημεριού."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vesi siellä, missä et yllä pohjaan. Keskikesän keskipäivän huippu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Air di sisi yang tak terjangkau kaki. Puncak langit siang di musim panas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vannet der du ikke når bunnen. Himmelens topp midt på dagen om høysommeren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het water in het diepe. De top van de lucht op een zomermiddag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woda tam, gdzie nie sięga się dna. Szczyt letniego południa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
