# DeployBar 배포 설정 — 하늘색 (SkyDex)
# 값만 고치고 키 순서와 주석은 그대로 둔다.

# 아카이브할 scheme. SkyDex.xcodeproj 에 공유된 이름 그대로.
SCHEME=SkyDex

# ios | macos
PLATFORM=ios

# 버전을 담은 xcconfig. MARKETING_VERSION 과 CURRENT_PROJECT_VERSION 이
# 여기에만 있고, 앱과 위젯 두 타겟이 프로젝트 수준에서 이 파일을 함께 읽는다.
VERSION_XCCONFIG=Config/Version.xcconfig

# 배포 전에 돌릴 검사. 0이 아닌 값으로 끝나면 배포를 멈춘다.
PREDEPLOY_SCRIPT=scripts/predeploy.sh

# 릴리즈 노트를 올릴 스토어 언어. 한국어가 원문이고 영어가 따라 쓴 것.
LOCALES=ko,en-US
