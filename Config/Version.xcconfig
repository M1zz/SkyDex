// 앱과 위젯이 함께 쓰는 버전. 두 타겟이 서로 다른 버전으로 아카이브되면
// 업로드 자체가 거절되므로, 고치는 자리는 이 파일 하나뿐이다.
//
// 프로젝트 수준(Debug/Release) 설정에 연결되어 있고, 타겟 빌드 설정에는
// MARKETING_VERSION / CURRENT_PROJECT_VERSION 을 두지 않는다 — 타겟에
// 값이 남아 있으면 그쪽이 이겨서 이 파일이 조용히 무시된다.

// 스토어에 보이는 버전. 예: 1.0.1
MARKETING_VERSION = 1.0.1

// 같은 버전 안에서 올라가는 빌드 번호. 버전이 바뀌면 1부터 다시 센다.
CURRENT_PROJECT_VERSION = 1
